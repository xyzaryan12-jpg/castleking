{
    "name": "castle-game",
    "version": "1.0.0",
    "description": "Math Castle – educational math game with Express backend and user authentication",
    "main": "server/server.js",
    "private": true,
    "scripts": {
        "start": "webpack serve --open --mode=development",
        "build": "webpack --mode=production",
        "serve": "node server/server.js",
        "dev:server": "nodemon server/server.js",
        "dev:client": "webpack serve --open --mode=development",
        "deploy": "npm run build && gh-pages -d dist",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kapaha/castle-game.git"
    },
    "keywords": ["math", "game", "education", "express", "authentication"],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/kapaha/castle-game/issues"
    },
    "homepage": "https://github.com/kapaha/castle-game#readme",
    "dependencies": {
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.6",
        "cookie-session": "^2.1.0",
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "express-session": "^1.17.3",
        "jsonwebtoken": "^9.0.2"
    },
    "devDependencies": {
        "css-loader": "^5.2.7",
        "eslint": "^7.30.0",
        "eslint-config-airbnb-base": "^14.2.1",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-import": "^2.23.4",
        "gh-pages": "^3.2.3",
        "html-loader": "^2.1.2",
        "html-webpack-plugin": "^5.3.2",
        "mini-css-extract-plugin": "^2.1.0",
        "nodemon": "^3.0.2",
        "prettier": "^2.3.2",
        "webpack": "^5.44.0",
        "webpack-cli": "^4.7.2",
        "webpack-dev-server": "^3.11.2"
    }
}
